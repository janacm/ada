#!/bin/bash
# Test double for `launchctl`, used by the LaunchAgent front doors
# (ada-paseo-watch.sh, ada-menubar.sh) and lib/ada-status.sh.
#   launchctl list                  -> one line per loaded label: STUB_LAUNCHCTL_LOADED
#                                      is "1" (the Paseo watcher, for older tests) or
#                                      a space-separated list of labels
#   launchctl print gui/<uid>/<lbl> -> "    pid = N" from STUB_LAUNCHCTL_PIDS
#                                      ("label=pid ..."), else STUB_LAUNCHCTL_PID
#   launchctl load ...              -> fails when STUB_LAUNCHCTL_LOAD_FAIL set
#   launchctl kickstart ...         -> fails when STUB_LAUNCHCTL_KICKSTART_FAIL set
# Every call is appended to STUB_LAUNCHCTL_LOG when that is set.
[ -n "${STUB_LAUNCHCTL_LOG:-}" ] && printf '%s\n' "$*" >> "$STUB_LAUNCHCTL_LOG"
case "$1" in
  list)
    case "${STUB_LAUNCHCTL_LOADED:-}" in
      "") ;;
      1) echo "com.ada.paseo-watch" ;;
      *) for label in $STUB_LAUNCHCTL_LOADED; do echo "$label"; done ;;
    esac
    ;;
  print)
    label=${2##*/}
    pid=""
    for pair in ${STUB_LAUNCHCTL_PIDS:-}; do
      [ "${pair%%=*}" = "$label" ] && pid=${pair#*=}
    done
    [ -z "$pid" ] && pid=${STUB_LAUNCHCTL_PID:-}
    [ -n "$pid" ] && printf '    pid = %s\n' "$pid"
    ;;
  load)
    [ -n "${STUB_LAUNCHCTL_LOAD_FAIL:-}" ] && exit 1
    ;;
  kickstart)
    [ -n "${STUB_LAUNCHCTL_KICKSTART_FAIL:-}" ] && exit 1
    ;;
  unload|bootstrap|bootout|enable|disable)
    # no-op success so `install`/`uninstall` can be tested without touching launchd
    ;;
esac
exit 0
